[Unit]
Description=local-host Docker Compose stack
Documentation=file:/etc/local-host/docker-compose.yaml
Requires=docker.service
# local-fs.target makes sure a separate /data disk is mounted before the
# script creates the volume directories under it.
After=docker.service network.target local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/etc/local-host
ExecStart=/usr/local/bin/local-host-compose
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
